{
    "name": "asmit/resized-column",
    "description": "Resizeable column for filament",
    "type": "library",
    "version": "4.0.0-beta.5",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Asmit\\ResizedColumn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asmit\\ResizedColumn\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "AsmitNepali",
            "email": "mail2asmitnepali@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "filament/support": "^3.2|^4.0|^5.0"
    },
    "require-dev": {
        "filament/tables": "^4.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "filament/filament": "^4.0"
    },
    "scripts": {
        "test": "pest",
        "build-assets": "node bin/build.js"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asmit\\ResizedColumn\\ResizedColumnServiceProvider"
            ]
        }
    }
}
